              }
            }
          },
          {
            "name": "pageNo",
            "in": "query",
            "description": "页码，从 1 开始",
            "required": true,
            "example": 1,
            "schema": {
              "type": "integer",
              "format": "int32",
              "description": "页码，从 1 开始",
              "minimum": 1,
              "example": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "每页条数，最大值为 200",
            "required": true,
            "example": 10,
            "schema": {
              "type": "integer",
              "format": "int32",
              "description": "每页条数，最大值为 200",
              "maximum": 200,
              "minimum": 1,
              "example": 10
            }
          },
          {
            "name": "tenant-id",
            "in": "header",
            "description": "租户编号",
            "required": false,
            "example": 0,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1,
              "description": "租户编号"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "认证 Token",
            "required": false,
            "example": "",
            "schema": {
              "type": "string",
              "default": "Bearer test1",
              "description": "认证 Token"
            }
          }
