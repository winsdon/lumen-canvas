            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Button"
            }
          }
        }
      },
      "AiMidjourneyImagineReqVO": {
        "type": "object",
        "description": "管理后台 - AI 绘画生成（Midjourney） Request VO",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "提示词",
            "minLength": 1,
            "example": "中国神龙"
          },
          "modelId": {
            "type": "integer",
            "format": "int64",
            "description": "模型编号",
            "example": 1
          },
          "width": {
            "type": "integer",
            "format": "int32",
            "description": "图片宽度",
            "example": 1
          },
          "height": {
            "type": "integer",
            "format": "int32",
            "description": "图片高度",
            "example": 1
          },
          "version": {
            "type": "string",
            "description": "版本号",
            "minLength": 1,
            "example": 6
          },
          "referImageUrl": {
            "type": "string",
            "description": "参考图",
            "example": "https://www.iocoder.cn/x.png"
          }
        },
        "required": [
          "height",
          "modelId",
          "prompt",
          "version",
          "width"
        ]
      },
      "AiMidjourneyActionReqVO": {
        "type": "object",
        "description": "管理后台 - AI 绘图操作（Midjourney） Request VO",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "图片编号",
            "example": 1
          },
          "customId": {
            "type": "string",
            "description": "操作按钮编号",
            "minLength": 1,
            "example": "MJ::JOB::variation::4::06aa3e66-0e97-49cc-8201-e0295d883de4"
          }
        },
        "required": [
          "customId",
          "id"
        ]
      },
      "AiImageDrawReqVO": {
        "type": "object",
        "description": "管理后台 - AI 绘画 Request VO",
        "properties": {
          "modelId": {
            "type": "integer",
            "format": "int64",
            "description": "模型编号",
            "example": 1024
          },
          "prompt": {
            "type": "string",
            "description": "提示词",
            "maxLength": 1200,
            "minLength": 0,
            "example": "画一个长城"
          },
          "height": {
            "type": "integer",
            "format": "int32",
            "description": "图片高度"
          },
          "width": {
            "type": "integer",
            "format": "int32",
            "description": "图片宽度"
          },
          "options": {
