  "paths": {
    "/app-api/infra/file/upload": {
      "post": {
        "summary": "上传文件",
        "deprecated": false,
        "description": "",
        "operationId": "uploadFile",
        "tags": [
          "用户 App - 文件存储"
        ],
        "parameters": [
          {
            "name": "directory",
            "in": "query",
            "description": "文件目录",
            "required": false,
            "example": "XXX/YYY",
            "schema": {
              "type": "string",
              "description": "文件目录",
              "example": "XXX/YYY"
            }
          },
          {
            "name": "tenant-id",
            "in": "header",
            "description": "租户编号",
            "required": false,
            "example": 0,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1,
              "description": "租户编号"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "认证 Token",
            "required": false,
            "example": "",
            "schema": {
              "type": "string",
              "default": "Bearer test1",
              "description": "认证 Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CommonResultString"
                }
              }
            },
            "headers": {}
          }
        },
        "security": []
      }
    },
    "/app-api/infra/file/create": {
      "post": {
        "summary": "创建文件",
        "deprecated": false,
        "description": "模式二：前端上传文件：配合 presigned-url 接口，记录上传了上传的文件",
        "operationId": "createFile",
        "tags": [
          "用户 App - 文件存储"
        ],
        "parameters": [
          {
            "name": "tenant-id",
            "in": "header",
            "description": "租户编号",
            "required": false,
            "example": 0,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1,
              "description": "租户编号"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "认证 Token",
            "required": false,
            "example": "",
            "schema": {
              "type": "string",
              "default": "Bearer test1",
              "description": "认证 Token"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FileCreateReqVO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CommonResultLong"
                }
              }
            },
            "headers": {}
          }
        },
        "security": []
      }
    },
    "/app-api/infra/file/presigned-url": {
      "get": {
        "summary": "获取文件预签名地址（上传）",
        "deprecated": false,
        "description": "模式二：前端上传文件：用于前端直接上传七牛、阿里云 OSS 等文件存储器",
        "operationId": "getFilePresignedUrl",
        "tags": [
          "用户 App - 文件存储"
        ],
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "description": "文件名称",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "directory",
            "in": "query",
            "description": "文件目录",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tenant-id",
            "in": "header",
            "description": "租户编号",
            "required": false,
            "example": 0,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1,
              "description": "租户编号"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "认证 Token",
            "required": false,
            "example": "",
            "schema": {
              "type": "string",
              "default": "Bearer test1",
              "description": "认证 Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CommonResultFilePresignedUrlRespVO"
                }
              }
            },
            "headers": {}
          }
        },
        "security": []
      }
    }
