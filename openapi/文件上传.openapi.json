  "components": {
    "schemas": {
      "CommonResultLong": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "CommonResultString": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "type": "string"
          }
        }
      },
      "FileCreateReqVO": {
        "type": "object",
        "description": "管理后台 - 文件创建 Request VO",
        "properties": {
          "configId": {
            "type": "integer",
            "format": "int64",
            "description": "文件配置编号",
            "example": 11
          },
          "path": {
            "type": "string",
            "description": "文件路径",
            "example": "yudao.jpg"
          },
          "name": {
            "type": "string",
            "description": "原文件名",
            "example": "yudao.jpg"
          },
          "url": {
            "type": "string",
            "description": "文件 URL",
            "example": "https://www.iocoder.cn/yudao.jpg"
          },
          "type": {
            "type": "string",
            "description": "文件 MIME 类型",
            "example": "application/octet-stream"
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "description": "文件大小",
            "example": 2048
          }
        },
        "required": [
          "configId",
          "name",
          "path",
          "size",
          "url"
        ]
      },
      "CommonResultFilePresignedUrlRespVO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/FilePresignedUrlRespVO"
          }
        }
      },
      "FilePresignedUrlRespVO": {
        "type": "object",
        "description": "管理后台 - 文件预签名地址 Response VO",
        "properties": {
          "configId": {
            "type": "integer",
            "format": "int64",
            "description": "配置编号",
            "example": 11
          },
          "uploadUrl": {
            "type": "string",
            "description": "文件上传 URL",
            "example": "https://s3.cn-south-1.qiniucs.com/ruoyi-vue-pro/758d3a5387507358c7236de4c8f96de1c7f5097ff6a7722b34772fb7b76b140f.png?X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Credential=3TvrJ70gl2Gt6IBe7_IZT1F6i_k0iMuRtyEv4EyS%2F20240217%2Fcn-south-1%2Fs3%2Faws4_request&X-Amz-Date=20240217T123222Z&X-Amz-Expires=600&X-Amz-SignedHeaders=host&X-Amz-Signature=a29f33770ab79bf523ccd4034d0752ac545f3c2a3b17baa1eb4e280cfdccfda5"
          },
          "url": {
            "type": "string",
            "description": "文件访问 URL",
            "example": "https://test.yudao.iocoder.cn/758d3a5387507358c7236de4c8f96de1c7f5097ff6a7722b34772fb7b76b140f.png"
          },
          "path": {
            "type": "string",
            "description": "文件路径",
            "example": "xxx.png"
          }
        },
        "required": [
          "configId",
          "path",
          "uploadUrl",
          "url"
        ]
      }
